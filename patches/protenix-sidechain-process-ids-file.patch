+
+def read_ids_file(path) -> set[str]:
+    """pdb_ids from a plain list or from any CSV carrying a pdb_id column."""
+    text = pathlib.Path(path).read_text()
+    first = text.split("\n", 1)[0]
+    if "," in first and "pdb_id" in first:
+        import io
+        column = next(
+            i for i, name in enumerate(first.split(",")) if name.strip() == "pdb_id"
+        )
+        reader = csv.reader(io.StringIO(text))
+        next(reader)
+        return {r[column].strip().lower() for r in reader if r and r[column].strip()}
+    return {line.strip().lower() for line in text.split() if line.strip()}
 
 
