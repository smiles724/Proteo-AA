__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/

.DS_Store

# rotamer-library build cache (regenerable)
.pdb_cache/

# Local scheduler output and generated experiment caches. Keep the directory
# hierarchy so Slurm always has a valid destination in a fresh checkout.
logs/*
!logs/training/
!logs/validation/
logs/training/*
!logs/training/*/
logs/training/*/*
!logs/training/*/.gitkeep
logs/validation/*
!logs/validation/*/
logs/validation/*/*
!logs/validation/*/.gitkeep
runs/
